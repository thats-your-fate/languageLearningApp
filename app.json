{
  "expo": {
    "name": "Language Flashcards",
    "slug": "language-flashcards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f7fb",
      "dark": {
        "backgroundColor": "#071120"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.anonymous.languageflashcards"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ff8a22"
      },
      "package": "com.anonymous.languageflashcards"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
